<!-- src/views/curso.ejs -->
<%- include('includes/head') %>
<%- include('includes/nav') %>

<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>

    <div class="col-lg-8 my-3">
      <h1 class="text-center">
        <% if(curso.id) { %>
          Editar Curso
        <% } else { %>
          Cadastrar Curso
        <% } %>
      </h1>
      <p class="text-center lead">Preencha os dados do curso abaixo.</p>

      <%- include('includes/messages') %>

      <% if(curso.id) { %>
      <form action="/curso/edit/<%= curso.id %>" method="POST">
      <% } else { %>
      <form action="/curso/register" method="POST">
      <% } %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <div class="form-group">
          <label>Nome do Curso *</label>
          <input value="<%= curso.nome || '' %>" type="text" class="form-control" name="nome" required>
        </div>
        
        <div class="form-group">
          <label>Código do Curso *</label>
          <input value="<%= curso.codigo || '' %>" type="text" class="form-control" name="codigo" required>
          <small class="form-text text-muted">Código único para identificar o curso (ex: ENG001, ADM002)</small>
        </div>
        
        <div class="form-group">
          <label>Descrição</label>
          <textarea class="form-control" name="descricao" rows="3"><%= curso.descricao || '' %></textarea>
        </div>
        
        <div class="form-group">
          <label>Duração (meses)</label>
          <input value="<%= curso.duracao || '' %>" type="number" class="form-control" name="duracao" min="1">
        </div>
        
        <div class="form-group">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="ativo" id="ativo" value="true"
                <%= (curso.ativo === undefined || curso.ativo === true) ? 'checked' : '' %>>
            <label class="form-check-label" for="ativo">
            Curso ativo
            </label>
        </div>
        </div>
        
        <div class="form-group">
          <button type="submit" class="btn btn-primary">
            <% if(curso.id) { %>
              Atualizar Curso
            <% } else { %>
              Cadastrar Curso
            <% } %>
          </button>
          <a href="/curso" class="btn btn-secondary">Voltar</a>
        </div>
      </form>
    </div>
    
    <div class="col-lg-2"></div>
  </div>
</div>

<%- include('includes/footer') %>