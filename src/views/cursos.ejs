<!-- src/views/cursos.ejs -->
<%- include('includes/head') %>
<%- include('includes/nav') %>

<div class="container">
  <div class="row">
    <div class="col-lg-12 my-3">
      <h1 class="text-center">Gerenciar Cursos</h1>
      <p class="text-center lead">Todos os cursos cadastrados no sistema</p>

      <%- include('includes/messages') %>

      <div class="text-right mb-3">
        <a href="/curso/index" class="btn btn-success">
          <i class="fas fa-plus"></i> Novo Curso
        </a>
      </div>

      <% if(cursos && cursos.length > 0) { %>
      <div class="responsive-table">
        <table class="table table-striped table-hover">
          <thead class="thead-dark">
            <tr>
              <th>Código</th>
              <th>Nome</th>
              <th>Descrição</th>
              <th>Duração</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% cursos.forEach(curso => { %>
            <tr>
              <td><strong><%= curso.codigo %></strong></td>
              <td><%= curso.nome %></td>
              <td><%= curso.descricao || '-' %></td>
              <td><%= curso.duracao ? curso.duracao + ' meses' : '-' %></td>
              <td>
                <span class="badge badge-<%= curso.ativo ? 'success' : 'danger' %>">
                  <%= curso.ativo ? 'Ativo' : 'Inativo' %>
                </span>
              </td>
              <td>
                <div class="btn-group" role="group">
                  <a href="/curso/index/<%= curso.id %>" class="btn btn-primary btn-sm">
                    <i class="fas fa-edit"></i> Editar
                  </a>
                  <a class="btn btn-danger btn-sm text-white" 
                     href="/curso/delete/<%= curso.id %>" 
                     onclick="return confirm('Tem certeza que deseja excluir este curso?')">
                    <i class="fas fa-trash"></i> Excluir
                  </a>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
        <div class="alert alert-info text-center">
          <h4 class="alert-heading">Nenhum curso encontrado</h4>
          <p class="mb-0">Não existem cursos cadastrados. Clique em "Novo Curso" para adicionar o primeiro.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('includes/footer') %>