<!-- src/views/index.ejs -->
<%- include('includes/head') %>
<%- include('includes/nav') %>

<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>

    <div class="col-lg-8 my-3">
      <h1 class="text-center">Alunos</h1>
      <p class="text-center lead">Seus alunos estão abaixo</p>

      <%- include('includes/messages') %>

      <div class="text-right mb-3">
        <!-- MUDE PARA /aluno -->
        <a href="/aluno" class="btn btn-success">
          <i class="fas fa-plus"></i> Novo Aluno
        </a>
        <a href="/curso" class="btn btn-info ml-2">
          <i class="fas fa-book"></i> Gerenciar Cursos
        </a>
      </div>

      <% if(alunos && alunos.length > 0) { %>
      <div class="responsive-table">
        <table class="table table-striped table-hover my-3">
          <thead class="thead-dark">
            <tr>
              <th>Nome</th>
              <th>Sobrenome</th>
              <th>Email</th>
              <th>Curso</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% alunos.forEach(aluno => { %>
            <tr>
              <td><%= aluno.nome %></td>
              <td><%= aluno.sobrenome || '-' %></td>
              <td><%= aluno.email || '-' %></td>
              <td>
                <% if(aluno.curso) { %>
                  <span class="badge badge-primary">
                    <%= aluno.curso.nome %> (<%= aluno.curso.codigo %>)
                  </span>
                <% } else if(aluno.curso_id) { %>
                  <span class="badge badge-warning">Curso ID: <%= aluno.curso_id %></span>
                <% } else { %>
                  <span class="badge badge-secondary">Nenhum</span>
                <% } %>
              </td>
              <td>
                <div class="btn-group" role="group">
                  <a href="/aluno/index/<%= aluno.id %>" class="btn btn-primary btn-sm" title="Editar">
                    <i class="fas fa-edit"></i> Editar
                  </a>
                  <a class="btn btn-danger btn-sm text-white" 
                     href="/aluno/delete/<%= aluno.id %>" 
                     title="Excluir"
                     onclick="return confirm('Tem certeza que deseja excluir este aluno?')">
                    <i class="fas fa-trash"></i> Excluir
                  </a>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
        <div class="alert alert-info text-center">
          <h4 class="alert-heading">Nenhum aluno encontrado</h4>
          <p class="mb-0">Não existem alunos na sua agenda. Clique no botão "Novo Aluno" para adicionar o primeiro.</p>
        </div>
      <% } %>
    </div>
    
    <div class="col-lg-2"></div>
  </div>
</div>

<%- include('includes/footer') %>