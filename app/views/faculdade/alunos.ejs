<!DOCTYPE html>
	<html lang="pt-br">
		<head>
			<meta charset="utf-8"/>
			<title>Alunos</title>
		</head>
	<body>

		<h1>Alunos</h1>

		<table>
			
			<tr>
				<td>ID</td>
				<td>Título</td>
			</tr>
			
			<% if (typeof alunos !== 'undefined' && alunos.length > 0) { %> 
				<% for(var i = 0; i < alunos.length; i++){ %>
					<tr>
						<td><%= alunos[i].id %></td>
						<td><%= alunos[i].nome %></td>
					</tr>
				<% } %>
			<% } else { %>
				<tr>
					<td colspan="2">Nenhum aluno encontrado.</td>
				</tr>
			<% } %>
			
			</table>

		</table>

	</body>
</html>